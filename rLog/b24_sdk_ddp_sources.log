SOURCE ultralytics/engine/trainer.py
233:     def run_callbacks(self, event: str):
234:         """Run all existing callbacks associated with a particular event."""
235:         for callback in self.callbacks.get(event, []):
236:             callback(self)
237: 
238:     def train(self):
239:         """Execute the training process, using DDP subprocess for multi-GPU or direct training for single-GPU."""
240:         # Run subprocess if DDP training, else train normally
241:         try:
242:             if self.world_size > 1 and self.args.batch < self.world_size:
243:                 raise ValueError(
244:                     f"'batch={self.args.batch}' must be >= GPU count {self.world_size} for Multi-GPU training "
245:                     f"(AutoBatch batch<1 is not supported), i.e. batch={self.world_size * 8}."
246:                 )
247:             if self.ddp:
248:                 # Argument checks
249:                 if self.args.rect:
250:                     LOGGER.warning("'rect=True' is incompatible with Multi-GPU training, setting 'rect=False'")
251:                     self.args.rect = False
252: 
253:                 # Command
254:                 cmd, file = None, None
255:                 try:
256:                     cmd, file = generate_ddp_command(self)
257:                     LOGGER.info(f"{colorstr('DDP:')} debug command {' '.join(cmd)}")
258:                     subprocess.run(cmd, check=True)
259:                 finally:
260:                     if file is not None:
261:                         ddp_cleanup(self, str(file))
262: 
263:             else:
264:                 self._do_train()
265:         finally:
266:             unset_deterministic()  # never leave deterministic state on, including the DDP parent and failed runs
267:             if not self.ddp:
268:                 self.run_callbacks("teardown")
