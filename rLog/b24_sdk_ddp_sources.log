SOURCE ultralytics/utils/dist.py
53: 
54:     This function creates a temporary Python file that enables distributed training across multiple GPUs, plus a
55:     companion `.pt` file holding the pickled trainer state that each DDP worker loads to rebuild the trainer.
56: 
57:     Args:
58:         trainer (ultralytics.engine.trainer.BaseTrainer): The trainer containing training configuration and arguments.
59:             Must have args attribute and be a class instance.
60: 
61:     Returns:
62:         (str): Path to the generated temporary DDP file.
63: 
64:     Notes:
65:         Both files are saved in the USER_CONFIG_DIR/DDP directory:
66:         - The `.pt` state file stores the trainer class, trainer arguments, model, and callbacks (via cloudpickle)
67:         - The `.py` script loads that state, rebuilds the trainer with the saved arguments as overrides, and trains
68:     """
69:     from .checks import check_requirements
70: 
71:     check_requirements("cloudpickle>=3.1.1")  # DDP-only, installed on first multi-GPU launch
72:     import cloudpickle
73: 
74:     (USER_CONFIG_DIR / "DDP").mkdir(exist_ok=True)
75:     with tempfile.NamedTemporaryFile(
76:         prefix="_temp_",
77:         suffix=f"{id(trainer)}.py",
78:         mode="w+",
79:         encoding="utf-8",
80:         dir=USER_CONFIG_DIR / "DDP",
81:         delete=False,
82:     ) as file:
83:         path = Path(file.name).with_suffix(".pt")
84:         torch_save(
85:             {
86:                 "trainer": type(trainer),
87:                 "args": vars(trainer.args),
88:                 "model": trainer.model,
89:                 "callbacks": trainer.callbacks,
90:             },
91:             path,
92:             pickle_module=cloudpickle,
93:         )
94:         file.write(
95:             f"""
96: # Ultralytics Multi-GPU training temp file (should be automatically deleted after use)
97: if __name__ == "__main__":
98:     import sys
99:     sys.path = {sys.path!r}
100: 
101:     from ultralytics.utils import DEFAULT_CFG_DICT
102:     from ultralytics.utils.patches import torch_load
103: 
104:     state = torch_load({str(path)!r}, map_location="cpu")
105: 
106:     cfg = DEFAULT_CFG_DICT.copy()
107:     cfg.update(save_dir='')   # handle the extra key 'save_dir'
108:     trainer = state["trainer"](cfg=cfg, overrides=state["args"], _callbacks=state["callbacks"])
109:     trainer.model = state["model"]
110:     trainer.train()
111: """
112:         )
113:     return file.name
114: 
