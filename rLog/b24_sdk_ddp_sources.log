220:     def wait_for_completion(
221:         self: Client,
222:         rq_id: str,
223:         *,
224:         status_check_period: int | None = None,
225:         log_prefix: str | None = None,
226:     ) -> tuple[models.Request, urllib3.HTTPResponse]:
227:         if status_check_period is None:
228:             status_check_period = self.config.status_check_period
229: 
230:         while True:
231:             request, response = self.api_client.requests_api.retrieve(rq_id)
232:             status, message = request.status, request.message
233: 
234:             log_prefix = log_prefix or f"{request.operation.type} operation"
235:             self.logger.info(
236:                 "%s status: %s (message=%s)",
237:                 log_prefix,
238:                 status,
239:                 message,
240:             )
241:             if status.value == models.RequestStatus.allowed_values[("value",)]["FINISHED"]:
242:                 break
243:             elif status.value == models.RequestStatus.allowed_values[("value",)]["FAILED"]:
244:                 raise BackgroundRequestException(message)
245: 
246:             sleep(status_check_period)
247: 
248:         return request, response
